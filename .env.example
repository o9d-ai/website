# ConvertKit (Kit) Integration
# Used for the waitlist signup form
#
# Get your Form ID from the URL when editing a form in Kit:
#   e.g., https://app.kit.com/forms/12345 → Form ID is 12345
#
# Get your API Key from Kit:
#   Settings → Developers → Add a new key
#
PUBLIC_CONVERTKIT_FORM_ID=
PUBLIC_CONVERTKIT_API_KEY=
