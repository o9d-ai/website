---
const currentYear = new Date().getFullYear();

const footerLinks = {
  Product: [
    { href: '#waitlist', label: 'Join Waitlist' },
  ],
  Resources: [
    { href: 'https://github.com/o9d-ai', label: 'GitHub' },
  ],
};
---

<footer class="bg-white border-t border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="font-mono text-xl text-neutral-900 font-bold tracking-tight">
          O9D
        </a>
        <p class="mt-4 text-sm text-neutral-500">
          The opinionated agent platform for developers.
        </p>
      </div>

      {Object.entries(footerLinks).map(([category, links]) => (
        <div>
          <h3 class="font-mono text-xs text-neutral-400 uppercase tracking-wider mb-4">
            {category}
          </h3>
          <ul class="space-y-3">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-neutral-600 hover:text-neutral-900 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-8 border-t border-neutral-200">
      <p class="text-sm text-neutral-400 text-center">
        © {currentYear} Opinionated AI. All rights reserved.
      </p>
    </div>
  </div>
</footer>
