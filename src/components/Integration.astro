---

---

<section class="py-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">
        Deploy anywhere, integrate everywhere
      </h2>
      <p class="text-lg text-neutral-500 max-w-2xl mx-auto">
        Use your curated agents through our Chat UI, embed them in your app, or connect via CLI. Our API is a drop-in replacement for Claude's /v1/messages endpoint.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- React SDK -->
      <div class="rounded-xl border border-neutral-200 bg-neutral-50 overflow-hidden">
        <div class="p-6 border-b border-neutral-200 bg-white">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38-.318-.184-.688-.277-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48 3.087-2.292 4.105-2.295zm-9.77.02c1.012 0 2.514.808 4.11 2.28-.686.72-1.37 1.537-2.02 2.442-1.107.117-2.154.298-3.113.538-.112-.49-.195-.964-.254-1.42-.23-1.868.054-3.32.714-3.707.19-.09.4-.127.563-.132zm4.882 3.05c.455.468.91.992 1.36 1.564-.44-.02-.89-.034-1.345-.034-.46 0-.915.01-1.36.034.44-.572.895-1.096 1.345-1.565zM12 8.1c.74 0 1.477.034 2.202.093.406.582.802 1.203 1.183 1.86.372.64.71 1.29 1.018 1.946-.308.655-.646 1.31-1.013 1.95-.38.66-.773 1.288-1.18 1.87-.728.063-1.466.098-2.21.098-.74 0-1.477-.035-2.202-.093-.406-.582-.802-1.204-1.183-1.86-.372-.64-.71-1.29-1.018-1.946.303-.657.646-1.313 1.013-1.954.38-.66.773-1.286 1.18-1.868.728-.064 1.466-.098 2.21-.098zm-3.635.254c-.24.377-.48.763-.704 1.16-.225.39-.435.782-.635 1.174-.265-.656-.49-1.31-.676-1.947.64-.15 1.315-.283 2.015-.386zm7.26 0c.695.103 1.365.23 2.006.387-.18.632-.405 1.282-.66 1.933-.2-.39-.41-.783-.64-1.174-.225-.392-.465-.774-.705-1.146zm3.063.675c.484.15.944.317 1.375.498 1.732.74 2.852 1.708 2.852 2.476-.005.768-1.125 1.74-2.857 2.475-.42.18-.88.342-1.355.493-.28-.958-.646-1.956-1.1-2.98.45-1.017.81-2.01 1.085-2.964zm-13.395.004c.278.96.645 1.957 1.1 2.98-.45 1.017-.812 2.01-1.086 2.964-.484-.15-.944-.318-1.37-.5-1.732-.737-2.852-1.706-2.852-2.474 0-.768 1.12-1.742 2.852-2.476.42-.18.88-.342 1.356-.494zm11.678 4.28c.265.657.49 1.312.676 1.948-.64.157-1.316.29-2.016.39.24-.375.48-.762.705-1.158.225-.39.435-.788.636-1.18zm-9.945.02c.2.392.41.783.64 1.175.23.39.465.772.705 1.143-.695-.102-1.365-.23-2.006-.386.18-.63.406-1.282.66-1.933zM17.92 16.32c.112.493.2.968.254 1.423.23 1.868-.054 3.32-.714 3.708-.147.09-.338.128-.563.128-1.012 0-2.514-.807-4.11-2.28.686-.72 1.37-1.536 2.02-2.44 1.107-.118 2.154-.3 3.113-.54zm-11.83.01c.96.234 2.006.415 3.107.532.66.905 1.345 1.727 2.035 2.446-1.595 1.483-3.092 2.295-4.11 2.295-.22-.005-.406-.05-.553-.132-.666-.38-.955-1.834-.73-3.703.054-.46.142-.944.25-1.438zm4.56.64c.44.02.89.034 1.345.034.46 0 .915-.01 1.36-.034-.44.572-.895 1.095-1.345 1.565-.455-.47-.91-.993-1.36-1.565z"/>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900">React Chat SDK</h3>
          </div>
          <p class="text-sm text-neutral-500">Embed a full-featured chat interface in your React app with 5 lines of code.</p>
        </div>
        <div class="p-4 bg-neutral-900 text-sm font-mono overflow-x-auto">
          <pre class="text-neutral-300"><code><span class="text-purple-400">import</span> {"{"} O9DChatProvider, O9DChatWidget {"}"} <span class="text-purple-400">from</span> <span class="text-green-400">"@o9d/react-chat"</span>;

<span class="text-neutral-500">// Wrap your app, add the widget</span>
&lt;<span class="text-blue-400">O9DChatProvider</span> <span class="text-yellow-400">agentId</span>=<span class="text-green-400">"your-agent"</span>&gt;
  &lt;<span class="text-blue-400">O9DChatWidget</span> /&gt;
&lt;/<span class="text-blue-400">O9DChatProvider</span>&gt;</code></pre>
        </div>
      </div>

      <!-- Anthropic-Compatible API -->
      <div class="rounded-xl border border-neutral-200 bg-neutral-50 overflow-hidden">
        <div class="p-6 border-b border-neutral-200 bg-white">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900">Anthropic-Compatible API</h3>
          </div>
          <p class="text-sm text-neutral-500">Drop-in replacement for Claude's /v1/messages. Use the Anthropic SDK you already know.</p>
        </div>
        <div class="p-4 bg-neutral-900 text-sm font-mono overflow-x-auto">
          <pre class="text-neutral-300"><code><span class="text-purple-400">from</span> anthropic <span class="text-purple-400">import</span> Anthropic

client = Anthropic(
  <span class="text-yellow-400">base_url</span>=<span class="text-green-400">"https://api.o9d.ai/v1"</span>,
  <span class="text-yellow-400">api_key</span>=<span class="text-green-400">"your-agent-api-key"</span>
)
<span class="text-neutral-500"># Tools auto-injected from your agent</span>
client.messages.create(...)</code></pre>
        </div>
      </div>

      <!-- CLI Agent -->
      <div class="rounded-xl border border-neutral-200 bg-neutral-50 overflow-hidden">
        <div class="p-6 border-b border-neutral-200 bg-white">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900">MCP Server</h3>
          </div>
          <p class="text-sm text-neutral-500">Expose your agents as an MCP server. Use with Claude Desktop, Cursor, or any MCP client.</p>
        </div>
        <div class="p-4 bg-neutral-900 text-sm font-mono overflow-x-auto">
          <pre class="text-neutral-300"><code><span class="text-neutral-500">// claude_desktop_config.json</span>
{"{"}
  <span class="text-blue-400">"mcpServers"</span>: {"{"}
    <span class="text-blue-400">"o9d"</span>: {"{"}
      <span class="text-blue-400">"url"</span>: <span class="text-green-400">"https://mcp.o9d.ai/your-agent"</span>
    {"}"}
  {"}"}
{"}"}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
