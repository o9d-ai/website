---

---

<section class="relative min-h-screen bg-[#fafafa] overflow-hidden">
  <!-- Subtle grid pattern background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e5e5e5_1px,transparent_1px),linear-gradient(to_bottom,#e5e5e5_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  
  <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-6 py-24">
    <!-- Main content -->
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-neutral-900 tracking-tight mb-6">
        The Opinionated Agent Platform
      </h1>
      
      <p class="text-lg md:text-xl text-neutral-500 max-w-2xl mx-auto mb-4">
        Turn your GraphQL queries, REST APIs, and MCP servers into high-leverage, context-rich AI tools. Curate them into focused agents. Deploy via our Chat SDK, CLI, or Anthropic-compatible API.
      </p>
      
      <p class="text-base text-neutral-400 max-w-xl mx-auto mb-12">
        Fewer tools + more context = better outcomes.
      </p>
      
      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
        <a
          href="#waitlist"
          class="px-8 py-3 bg-neutral-900 text-white font-semibold rounded-lg hover:bg-neutral-800 transition-colors"
        >
          Join the Waitlist
        </a>
        <a
          href="https://github.com/o9d-ai"
          class="px-8 py-3 border border-neutral-300 text-neutral-900 font-semibold rounded-lg hover:border-neutral-400 hover:bg-neutral-100 transition-colors"
        >
          View on GitHub
        </a>
      </div>
    </div>
    
    <!-- App UI preview -->
    <div class="w-full max-w-4xl mx-auto">
      <div class="rounded-xl border border-neutral-200 bg-white shadow-2xl shadow-neutral-200/50 overflow-hidden">
        <!-- Browser-style title bar -->
        <div class="flex items-center gap-2 px-4 py-3 bg-neutral-50 border-b border-neutral-200">
          <div class="w-3 h-3 rounded-full bg-neutral-300"></div>
          <div class="w-3 h-3 rounded-full bg-neutral-300"></div>
          <div class="w-3 h-3 rounded-full bg-neutral-300"></div>
          <div class="flex-1 mx-4">
            <div class="max-w-md mx-auto bg-white border border-neutral-200 rounded-md px-3 py-1.5 text-sm text-neutral-400 font-mono">
              app.o9d.ai/agents
            </div>
          </div>
        </div>
        
        <!-- App content preview -->
        <div class="p-6 bg-white">
          <div class="flex gap-6">
            <!-- Sidebar -->
            <div class="w-48 shrink-0 border-r border-neutral-100 pr-6">
              <div class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">Agents</div>
              <div class="space-y-1">
                <div class="px-3 py-2 bg-neutral-100 rounded-lg text-sm font-medium text-neutral-900">Architecture Search</div>
                <div class="px-3 py-2 text-sm text-neutral-500 hover:bg-neutral-50 rounded-lg">Code Review</div>
                <div class="px-3 py-2 text-sm text-neutral-500 hover:bg-neutral-50 rounded-lg">Docs Writer</div>
              </div>
            </div>
            
            <!-- Main panel -->
            <div class="flex-1">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-neutral-900">Architecture Search</h3>
                <span class="px-2 py-1 bg-emerald-50 text-emerald-700 text-xs font-medium rounded">Active</span>
              </div>
              
              <div class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2">Connected Tools</div>
              <div class="grid grid-cols-2 gap-3">
                <div class="flex items-center gap-3 p-3 border border-neutral-200 rounded-lg">
                  <div class="w-8 h-8 bg-neutral-100 rounded-lg flex items-center justify-center">
                    <svg class="w-4 h-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                  </div>
                  <div>
                    <div class="text-sm font-medium text-neutral-900">Notion Search</div>
                    <div class="text-xs text-neutral-400">Team: Engineering</div>
                  </div>
                </div>
                <div class="flex items-center gap-3 p-3 border border-neutral-200 rounded-lg">
                  <div class="w-8 h-8 bg-neutral-100 rounded-lg flex items-center justify-center">
                    <svg class="w-4 h-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  </div>
                  <div>
                    <div class="text-sm font-medium text-neutral-900">GitHub API</div>
                    <div class="text-xs text-neutral-400">GraphQL endpoint</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
